{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vertex.local/schemas/projectile-motion-1.0.json",
  "title": "Projectile Motion Configuration Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment",
    "version",
    "mass",
    "initialVelocity",
    "launchAngle",
    "gravity",
    "initialHeight",
    "airResistance"
  ],
  "properties": {
    "experiment": { "const": "projectile_motion" },
    "version": { "const": "1.0" },
    "mass": { "type": "number", "exclusiveMinimum": 0 },
    "initialVelocity": { "type": "number", "minimum": 0 },
    "launchAngle": { "type": "number", "minimum": 0, "maximum": 90 },
    "gravity": { "type": "number", "exclusiveMinimum": 0 },
    "initialHeight": { "type": "number", "minimum": 0 },
    "airResistance": { "type": "number", "minimum": 0 }
  }
}
